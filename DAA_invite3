//server.js for mongo with 
const http = require("http");
const fs = require("fs");
const path = require("path");
const { MongoClient } = require("mongodb");

const PORT = 3000;
const MONGO_URL = "mongodb://127.0.0.1:27017";

const client = new MongoClient(MONGO_URL);

let booksCollection;

// Send JSON response
function sendJSON(res, status, data) {
    res.writeHead(status, {
        "Content-Type": "application/json"
    });
    res.end(JSON.stringify(data));
}

// Read JSON request body
function readBody(req) {
    return new Promise((resolve, reject) => {
        let body = "";

        req.on("data", chunk => body += chunk);

        req.on("end", () => {
            try {
                resolve(JSON.parse(body || "{}"));
            } catch {
                reject(new Error("Invalid JSON"));
            }
        });

        req.on("error", reject);
    });
}

// Check and prepare book fields
function prepareBook(body) {
    const id = Number(body.id);
    const copies = Number(body.copies);

    if (
        body.id === undefined || body.id === "" ||
        !Number.isSafeInteger(id) || id <= 0 ||
        typeof body.title !== "string" || !body.title.trim() ||
        typeof body.author !== "string" || !body.author.trim() ||
        typeof body.category !== "string" || !body.category.trim() ||
        typeof body.isbn !== "string" || !body.isbn.trim() ||
        body.copies === undefined || body.copies === "" ||
        !Number.isSafeInteger(copies) || copies < 0
    ) {
        throw new Error("Enter valid book details.");
    }

    return {
        id,
        title: body.title.trim(),
        author: body.author.trim(),
        category: body.category.trim(),
        isbn: body.isbn.trim(),
        copies
    };
}

// Create HTTP server
const server = http.createServer(async (req, res) => {
    const url = new URL(req.url, "http://localhost");
    const pathname = url.pathname;

    try {
        // READ: Get all books
        if (req.method === "GET" && pathname === "/books") {
            const books = await booksCollection
                .find({})
                .sort({ id: 1 })
                .toArray();

            return sendJSON(res, 200, books);
        }

        // CREATE: Add a book
        if (req.method === "POST" && pathname === "/books") {
            const body = await readBody(req);
            const book = prepareBook(body);

            const existing = await booksCollection.findOne({
                id: book.id
            });

            if (existing) {
                return sendJSON(res, 409, {
                    message: "Book ID already exists."
                });
            }

            await booksCollection.insertOne(book);

            return sendJSON(res, 201, {
                message: "Book added successfully."
            });
        }

        // UPDATE: Update a book by its numeric ID
        if (req.method === "PUT" && pathname.startsWith("/books/")) {
            const id = Number(pathname.split("/")[2]);

            if (!Number.isSafeInteger(id) || id <= 0) {
                return sendJSON(res, 400, {
                    message: "Invalid Book ID."
                });
            }

            const body = await readBody(req);
            const book = prepareBook({ ...body, id });

            const result = await booksCollection.updateOne(
                { id },
                { $set: book }
            );

            if (result.matchedCount === 0) {
                return sendJSON(res, 404, {
                    message: "Book ID not found."
                });
            }

            return sendJSON(res, 200, {
                message: "Book updated successfully."
            });
        }

        // DELETE: Delete a book by its numeric ID
        if (req.method === "DELETE" && pathname.startsWith("/books/")) {
            const id = Number(pathname.split("/")[2]);

            if (!Number.isSafeInteger(id) || id <= 0) {
                return sendJSON(res, 400, {
                    message: "Invalid Book ID."
                });
            }

            const result = await booksCollection.deleteOne({ id });

            if (result.deletedCount === 0) {
                return sendJSON(res, 404, {
                    message: "Book ID not found."
                });
            }

            return sendJSON(res, 200, {
                message: "Book deleted successfully."
            });
        }

        // Serve the Bootstrap frontend
        if (req.method === "GET" && pathname === "/") {
            const file = path.join(__dirname, "public", "index.html");

            fs.readFile(file, (err, content) => {
                if (err) {
                    res.writeHead(500, {
                        "Content-Type": "text/plain"
                    });
                    return res.end("Cannot load index.html");
                }

                res.writeHead(200, {
                    "Content-Type": "text/html; charset=utf-8"
                });
                res.end(content);
            });

            return;
        }

        sendJSON(res, 404, { message: "Route not found." });

    } catch (err) {
        console.error(err);

        if (err.code === 11000) {
            return sendJSON(res, 409, {
                message: "Book ID already exists."
            });
        }

        sendJSON(res, err.message === "Invalid JSON" ? 400 : 500, {
            message: err.message || "Internal server error."
        });
    }
});

// Connect to MongoDB before accepting requests
async function startServer() {
    try {
        await client.connect();

        const db = client.db("library_db");
        booksCollection = db.collection("books");

        // Ensure each book has a unique numeric ID
        await booksCollection.createIndex({ id: 1 }, { unique: true });

        server.listen(PORT, () => {
            console.log("Connected to MongoDB!");
            console.log(`Server running at http://localhost:${PORT}`);
        });
    } catch (err) {
        console.error("Could not start server:", err.message);
        await client.close().catch(() => {});
        process.exitCode = 1;
    }
}

startServer();






























