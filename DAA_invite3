<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Library Management</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
</head>

<body class="bg-light">

<div class="container mt-5 mb-5">
    <h1 class="text-center mb-4">Library Management System</h1>

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            Book Details
        </div>

        <div class="card-body">
            <form id="bookForm">
                <div class="row g-3">

                    <div class="col-md-6">
                        <label for="id" class="form-label">Book ID</label>
                        <input type="number" id="id" min="1"
                               class="form-control" required>
                    </div>

                    <div class="col-md-6">
                        <label for="title" class="form-label">Title</label>
                        <input type="text" id="title"
                               class="form-control" required>
                    </div>

                    <div class="col-md-6">
                        <label for="author" class="form-label">Author</label>
                        <input type="text" id="author"
                               class="form-control" required>
                    </div>

                    <div class="col-md-6">
                        <label for="category" class="form-label">Category</label>
                        <input type="text" id="category"
                               class="form-control" required>
                    </div>

                    <div class="col-md-6">
                        <label for="isbn" class="form-label">ISBN</label>
                        <input type="text" id="isbn"
                               class="form-control" required>
                    </div>

                    <div class="col-md-6">
                        <label for="copies" class="form-label">Copies</label>
                        <input type="number" id="copies" min="0"
                               class="form-control" required>
                    </div>

                    <div class="col-12">
                        <button type="submit" class="btn btn-success">
                            Add Book
                        </button>

                        <button type="button" onclick="updateBook()"
                                class="btn btn-warning">
                            Update
                        </button>

                        <button type="button" onclick="deleteBook()"
                                class="btn btn-danger">
                            Delete
                        </button>

                        <button type="button" onclick="clearForm()"
                                class="btn btn-secondary">
                            Clear
                        </button>
                    </div>

                </div>
            </form>

            <p id="message" class="mt-3"></p>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-dark text-white">
            Book Records
        </div>

        <div class="card-body table-responsive">
            <table class="table table-bordered table-striped table-hover">
                <thead class="table-primary">
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Author</th>
                        <th>Category</th>
                        <th>ISBN</th>
                        <th>Copies</th>
                    </tr>
                </thead>

                <tbody id="bookTable"></tbody>
            </table>
        </div>
    </div>
</div>

<script>
    const form = document.getElementById("bookForm");
    const table = document.getElementById("bookTable");
    const message = document.getElementById("message");

    function showMessage(text, error = false) {
        message.textContent = text;
        message.className = error
            ? "mt-3 text-danger"
            : "mt-3 text-success";
    }

    function getFormData() {
        return {
            id: Number(document.getElementById("id").value),
            title: document.getElementById("title").value.trim(),
            author: document.getElementById("author").value.trim(),
            category: document.getElementById("category").value.trim(),
            isbn: document.getElementById("isbn").value.trim(),
            copies: Number(document.getElementById("copies").value)
        };
    }

    // Common function to send requests to the backend
    async function apiRequest(url, method, data) {
        const options = { method };

        if (data !== undefined) {
            options.headers = {
                "Content-Type": "application/json"
            };
            options.body = JSON.stringify(data);
        }

        const response = await fetch(url, options);
        const result = await response.json();

        if (!response.ok) {
            throw new Error(result.message || "Request failed.");
        }

        return result;
    }

    // READ: Fetch all books from MongoDB
    async function displayBooks() {
        try {
            const books = await apiRequest("/books", "GET");
            table.innerHTML = "";

            books.forEach(book => {
                const row = document.createElement("tr");

                [
                    book.id, book.title, book.author,
                    book.category, book.isbn, book.copies
                ].forEach(value => {
                    const cell = document.createElement("td");
                    cell.textContent = value;
                    row.appendChild(cell);
                });

                // Click row to fill the form
                row.style.cursor = "pointer";

                row.onclick = () => {
                    document.getElementById("id").value = book.id;
                    document.getElementById("title").value = book.title;
                    document.getElementById("author").value = book.author;
                    document.getElementById("category").value = book.category;
                    document.getElementById("isbn").value = book.isbn;
                    document.getElementById("copies").value = book.copies;
                };

                table.appendChild(row);
            });
        } catch (error) {
            showMessage(error.message, true);
        }
    }

    // CREATE: Insert a book
    form.addEventListener("submit", async event => {
        event.preventDefault();

        try {
            const result = await apiRequest(
                "/books", "POST", getFormData()
            );

            showMessage(result.message);
            clearForm();
            await displayBooks();
        } catch (error) {
            showMessage(error.message, true);
        }
    });

    // UPDATE: Modify a book
    async function updateBook() {
        if (!form.reportValidity()) return;

        const id = document.getElementById("id").value;

        try {
            const result = await apiRequest(
                "/books/" + encodeURIComponent(id),
                "PUT",
                getFormData()
            );

            showMessage(result.message);
            clearForm();
            await displayBooks();
        } catch (error) {
            showMessage(error.message, true);
        }
    }

    // DELETE: Remove a book
    async function deleteBook() {
        const id = document.getElementById("id").value;

        if (id === "") {
            showMessage("Enter or select a Book ID first.", true);
            return;
        }

        if (!confirm("Are you sure you want to delete this book?")) {
            return;
        }

        try {
            const result = await apiRequest(
                "/books/" + encodeURIComponent(id),
                "DELETE"
            );

            showMessage(result.message);
            clearForm();
            await displayBooks();
        } catch (error) {
            showMessage(error.message, true);
        }
    }

    function clearForm() {
        form.reset();
    }

    // Load records when the page opens
    displayBooks();
</script>

</body>
</html>














































































