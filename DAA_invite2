  <script>
    // Temporary in-memory records. Replace this array with backend/MySQL API calls later.
    let books = [];

    function getFormData() {
      return {
        id: document.getElementById("bookId").value.trim(),
        title: document.getElementById("title").value.trim(),
        author: document.getElementById("author").value.trim(),
        category: document.getElementById("category").value.trim(),
        isbn: document.getElementById("isbn").value.trim(),
        copies: document.getElementById("copies").value.trim()
      };
    }

    function validateBook(book) {
      if (!book.id || !book.title || !book.author || !book.category || !book.isbn || book.copies === "") {
        showMessage("Please fill in all fields.", true);
        return false;
      }
      if (!Number.isInteger(Number(book.id)) || Number(book.id) < 1) {
        showMessage("Book ID must be a positive whole number.", true);
        return false;
      }
      if (!Number.isInteger(Number(book.copies)) || Number(book.copies) < 0) {
        showMessage("Copies must be zero or a positive whole number.", true);
        return false;
      }
      return true;
    }

    function renderBooks() {
      const table = document.getElementById("bookTable");
      table.innerHTML = "";

      books.forEach(book => {
        const row = document.createElement("tr");
        row.className = "hover:bg-gray-50";
        [book.id, book.title, book.author, book.category, book.isbn, book.copies].forEach(value => {
          const cell = document.createElement("td");
          cell.className = "break-words border p-3";
          cell.textContent = value;
          row.appendChild(cell);
        });
        table.appendChild(row);
      });

      document.getElementById("emptyMessage").classList.toggle("hidden", books.length > 0);
    }

    function addBook() {
      const book = getFormData();
      if (!validateBook(book)) return;

      if (books.some(item => item.id === book.id)) {
        showMessage("This Book ID already exists. Use Update Book to change the record.", true);
        return;
      }

      books.push(book);
      renderBooks();
      clearForm();
      showMessage("Book added successfully.");
    }

    function updateBook() {
      const book = getFormData();
      if (!validateBook(book)) return;

      const index = books.findIndex(item => item.id === book.id);
      if (index === -1) {
        showMessage("Book ID not found. Enter an existing ID to update.", true);
        return;
      }

      books[index] = book;
      renderBooks();
      clearForm();
      showMessage("Book updated successfully.");
    }

    function deleteBook() {
      const id = document.getElementById("bookId").value.trim();
      if (!id) {
        showMessage("Enter the Book ID to delete.", true);
        return;
      }

      const index = books.findIndex(item => item.id === id);
      if (index === -1) {
        showMessage("Book ID not found.", true);
        return;
      }

      if (!confirm("Delete book ID " + id + "?")) return;
      books.splice(index, 1);
      renderBooks();
      clearForm();
      showMessage("Book deleted successfully.");
    }

    function clearForm() {
      document.getElementById("bookForm").reset();
    }

    function showMessage(message, isError = false) {
      const element = document.getElementById("message");
      element.textContent = message;
      element.className = "mt-3 text-sm " + (isError ? "text-red-600" : "text-green-700");
    }

    renderBooks();
  </script>
</body>
</html>




































































































