<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Library Management</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 min-h-screen p-6">

    <div class="max-w-5xl mx-auto bg-white p-6 rounded-lg shadow">

        <h1 class="text-3xl font-bold text-center mb-6">
            Library Management System
        </h1>

        <!-- Book Form -->
        <form id="bookForm" class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">

            <input type="number" id="id" placeholder="Book ID"
                class="border p-2 rounded" required>

            <input type="text" id="title" placeholder="Book Title"
                class="border p-2 rounded" required>

            <input type="text" id="author" placeholder="Author"
                class="border p-2 rounded" required>

            <input type="text" id="category" placeholder="Category"
                class="border p-2 rounded" required>

            <input type="text" id="isbn" placeholder="ISBN"
                class="border p-2 rounded" required>

            <input type="number" id="copies" placeholder="Number of Copies"
                min="0" class="border p-2 rounded" required>

            <div class="md:col-span-2 flex flex-wrap gap-3">
                <button type="submit"
                    class="bg-blue-600 text-white px-5 py-2 rounded">
                    Add Book
                </button>

                <button type="button" onclick="updateBook()"
                    class="bg-yellow-500 text-white px-5 py-2 rounded">
                    Update Book
                </button>

                <button type="button" onclick="deleteBook()"
                    class="bg-red-600 text-white px-5 py-2 rounded">
                    Delete Book
                </button>

                <button type="button" onclick="clearForm()"
                    class="bg-gray-500 text-white px-5 py-2 rounded">
                    Clear
                </button>
            </div>
        </form>

        <p id="message" class="mb-4 font-medium"></p>

        <!-- Book Table -->
        <h2 class="text-xl font-semibold mb-3">Book Records</h2>

        <div class="overflow-x-auto">
            <table class="w-full border-collapse border">
                <thead class="bg-gray-200">
                    <tr>
                        <th class="border p-2">ID</th>
                        <th class="border p-2">Title</th>
                        <th class="border p-2">Author</th>
                        <th class="border p-2">Category</th>
                        <th class="border p-2">ISBN</th>
                        <th class="border p-2">Copies</th>
                    </tr>
                </thead>

                <tbody id="bookTable"></tbody>
            </table>
        </div>
    </div>

    <script>
        const form = document.getElementById("bookForm");
        const table = document.getElementById("bookTable");
        const message = document.getElementById("message");

        // Read all books from the server
        async function loadBooks() {
            try {
                const response = await fetch("/books");
                const books = await response.json();

                table.innerHTML = "";

                books.forEach(book => {
                    const row = document.createElement("tr");

                    [
                        book.id, book.title, book.author,
                        book.category, book.isbn, book.copies
                    ].forEach(value => {
                        const cell = document.createElement("td");
                        cell.className = "border p-2";
                        cell.textContent = value;
                        row.appendChild(cell);
                    });

                    // Click a row to fill the form for editing
                    row.className = "cursor-pointer hover:bg-blue-50";
                    row.onclick = () => {
                        document.getElementById("id").value = book.id;
                        document.getElementById("title").value = book.title;
                        document.getElementById("author").value = book.author;
                        document.getElementById("category").value = book.category;
                        document.getElementById("isbn").value = book.isbn;
                        document.getElementById("copies").value = book.copies;
                    };

                    table.appendChild(row);
                });
            } catch (error) {
                showMessage("Could not load books.", true);
            }
        }

        // Display a message
        function showMessage(text, isError = false) {
            message.textContent = text;
            message.className = isError
                ? "mb-4 font-medium text-red-600"
                : "mb-4 font-medium text-green-600";
        }

        // CREATE: Add a book
        form.addEventListener("submit", async function(event) {
            event.preventDefault();

            const book = getFormData();

            try {
                const response = await fetch("/books", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(book)
                });

                const result = await response.json();

                if (!response.ok) throw new Error(result.error || result.message);

                showMessage(result.message);
                clearForm();
                loadBooks();
            } catch (error) {
                showMessage(error.message || "Unable to add book.", true);
            }
        });

        // Collect data from the form
        function getFormData() {
            return {
                id: Number(document.getElementById("id").value),
                title: document.getElementById("title").value.trim(),
                author: document.getElementById("author").value.trim(),
                category: document.getElementById("category").value.trim(),
                isbn: document.getElementById("isbn").value.trim(),
                copies: Number(document.getElementById("copies").value)
            };
        }

        // UPDATE: Update a book using its ID
        async function updateBook() {
            const id = document.getElementById("id").value;

            if (!id) {
                showMessage("Enter or select a Book ID first.", true);
                return;
            }

            try {
                const response = await fetch("/books/" + id, {
                    method: "PUT",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(getFormData())
                });

                const result = await response.json();

                if (!response.ok) throw new Error(result.error || result.message);

                showMessage(result.message);
                clearForm();
                loadBooks();
            } catch (error) {
                showMessage(error.message || "Unable to update book.", true);
            }
        }

        // DELETE: Delete a book using its ID
        async function deleteBook() {
            const id = document.getElementById("id").value;

            if (!id) {
                showMessage("Enter or select a Book ID first.", true);
                return;
            }

            if (!confirm("Are you sure you want to delete this book?")) {
                return;
            }

            try {
                const response = await fetch("/books/" + id, {
                    method: "DELETE"
                });

                const result = await response.json();

                if (!response.ok) throw new Error(result.error || result.message);

                showMessage(result.message);
                clearForm();
                loadBooks();
            } catch (error) {
                showMessage(error.message || "Unable to delete book.", true);
            }
        }

        // Clear the form
        function clearForm() {
            form.reset();
        }

        // Load records when the page opens
        loadBooks();
    </script>

</body>
</html>


