    <!-- Form -->
    <form id="bookForm" class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-5">

        <input id="id" type="number" placeholder="Book ID"
            class="border p-2 rounded" required>

        <input id="title" type="text" placeholder="Book Title"
