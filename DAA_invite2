          <thead class="bg-gray-200">
            <tr>
              <th class="border p-3">Book ID</th>
              <th class="border p-3">Title</th>
              <th class="border p-3">Author</th>
              <th class="border p-3">Category</th>
              <th class="border p-3">ISBN</th>
              <th class="border p-3">Copies</th>
            </tr>
          </thead>
          <tbody id="bookTable"></tbody>
        </table>
        <p id="emptyMessage" class="hidden py-6 text-center text-gray-500">No book records yet. Add a book using the form above.</p>
      </div>
      <p class="mt-4 text-sm text-gray-500">Demo only: records are stored in browser memory and reset when the page is refreshed. MySQL can be connected later.</p>
    </section>
