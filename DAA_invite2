            </button>

            <button type="button" onclick="updateBook()"
                class="bg-yellow-500 text-white px-4 py-2 rounded">
                Update Book
            </button>

            <button type="button" onclick="deleteBook()"
                class="bg-red-600 text-white px-4 py-2 rounded">
                Delete Book
            </button>

            <button type="button" onclick="clearForm()"
                class="bg-gray-500 text-white px-4 py-2 rounded">
                Clear
            </button>
        </div>
    </form>

    <p id="message" class="mb-4 font-semibold"></p>

    <!-- Table -->
    <div class="overflow-x-auto">
        <table class="w-full border-collapse border">
            <thead class="bg-gray-200">
                <tr>
                    <th class="border p-2">ID</th>
                    <th class="border p-2">Title</th>
                    <th class="border p-2">Author</th>
                    <th class="border p-2">Category</th>
                    <th class="border p-2">ISBN</th>
                    <th class="border p-2">Copies</th>
                </tr>
            </thead>
            <tbody id="bookTable"></tbody>
        </table>
    </div>

</div>

<script>
    const form = document.getElementById("bookForm");
    const table = document.getElementById("bookTable");
    const message = document.getElementById("message");

    // Read saved records from localStorage
    function getBooks() {
        return JSON.parse(localStorage.getItem("books")) || [];
    }

    // Save records to localStorage
    function saveBooks(books) {
        localStorage.setItem("books", JSON.stringify(books));
    }

    // Display all books
    function displayBooks() {
        const books = getBooks();
        table.innerHTML = "";

        books.forEach(book => {
            const row = document.createElement("tr");
            row.className = "hover:bg-gray-100 cursor-pointer";

            [
                book.id, book.title, book.author,
                book.category, book.isbn, book.copies
            ].forEach(value => {
                const cell = document.createElement("td");
                cell.className = "border p-2";
                cell.textContent = value;
                row.appendChild(cell);
            });

            // Click row to select a book
            row.onclick = () => {
                document.getElementById("id").value = book.id;
                document.getElementById("title").value = book.title;
                document.getElementById("author").value = book.author;
                document.getElementById("category").value = book.category;
                document.getElementById("isbn").value = book.isbn;
                document.getElementById("copies").value = book.copies;
            };

            table.appendChild(row);
        });
    }

    // Display status message
    function showMessage(text, error = false) {
        message.textContent = text;
        message.className = error
            ? "mb-4 font-semibold text-red-600"
            : "mb-4 font-semibold text-green-600";
    }

    // CREATE
    form.addEventListener("submit", function(event) {
        event.preventDefault();

        const books = getBooks();
        const id = Number(document.getElementById("id").value);

        if (books.some(book => book.id === id)) {
            showMessage("Book ID already exists!", true);
            return;
        }

        const book = {
            id: id,
            title: document.getElementById("title").value.trim(),
            author: document.getElementById("author").value.trim(),
            category: document.getElementById("category").value.trim(),
            isbn: document.getElementById("isbn").value.trim(),
            copies: Number(document.getElementById("copies").value)
        };

        books.push(book);
        saveBooks(books);
        displayBooks();
        clearForm();
        showMessage("Book added successfully!");
    });

    // UPDATE
    function updateBook() {
        const books = getBooks();
        const id = Number(document.getElementById("id").value);
        const index = books.findIndex(book => book.id === id);

        if (index === -1) {
            showMessage("Book ID not found!", true);
            return;
        }

        books[index] = {
            id: id,
            title: document.getElementById("title").value.trim(),
            author: document.getElementById("author").value.trim(),
            category: document.getElementById("category").value.trim(),
            isbn: document.getElementById("isbn").value.trim(),
            copies: Number(document.getElementById("copies").value)
        };

        if (!form.reportValidity()) return;

        saveBooks(books);
        displayBooks();
        clearForm();
        showMessage("Book updated successfully!");
    }

    // DELETE
    function deleteBook() {
        const id = Number(document.getElementById("id").value);
        let books = getBooks();

        if (!books.some(book => book.id === id)) {
            showMessage("Book ID not found!", true);
            return;
        }

        books = books.filter(book => book.id !== id);
        saveBooks(books);
        displayBooks();
        clearForm();
        showMessage("Book deleted successfully!");
    }

    // CLEAR FORM
    function clearForm() {
        form.reset();
    }

    // Load saved records on page open
    displayBooks();
</script>

</body>
</html>











































































