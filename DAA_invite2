//server.js

const http = require("http");
const fs = require("fs");
const path = require("path");
const mysql = require("mysql2");

const PORT = 3000;

// 1. Connect to MySQL
const db = mysql.createConnection({
    host: "localhost",
    user: "root",
    password: "",
    database: "library_db"
});

db.connect((err) => {
    if (err) {
        console.log("Database connection failed:", err.message);
        return;
    }
    console.log("Connected to MySQL!");
});

// 2. Helper: send JSON response
function sendJSON(res, statusCode, data) {
    res.writeHead(statusCode, {
        "Content-Type": "application/json"
    });
    res.end(JSON.stringify(data));
}

// 3. Helper: read JSON request body
function readBody(req, callback) {
    let body = "";

    req.on("data", chunk => {
        body += chunk;
    });

    req.on("end", () => {
        try {
            callback(null, JSON.parse(body || "{}"));
        } catch (err) {
            callback(err);
        }
    });
}

// 4. Create HTTP server
const server = http.createServer((req, res) => {
    const url = new URL(req.url, `http://${req.headers.host}`);

    // READ: Get all books
    if (req.method === "GET" && url.pathname === "/books") {
        db.query("SELECT * FROM books", (err, results) => {
            if (err) return sendJSON(res, 500, { error: err.message });
            sendJSON(res, 200, results);
        });
    }

    // CREATE: Add a book
    else if (req.method === "POST" && url.pathname === "/books") {
        readBody(req, (err, book) => {
            if (err) return sendJSON(res, 400, { error: "Invalid JSON" });

            const sql = `INSERT INTO books
                (id, title, author, category, isbn, copies)
                VALUES (?, ?, ?, ?, ?, ?)`;

            const values = [
                book.id, book.title, book.author,
                book.category, book.isbn, book.copies
            ];

            db.query(sql, values, (err) => {
                if (err) return sendJSON(res, 500, { error: err.message });
                sendJSON(res, 201, { message: "Book added successfully" });
            });
        });
    }

    // UPDATE: Modify a book by ID
    else if (req.method === "PUT" && url.pathname.startsWith("/books/")) {
        const id = url.pathname.split("/")[2];

        readBody(req, (err, book) => {
            if (err) return sendJSON(res, 400, { error: "Invalid JSON" });

            const sql = `UPDATE books
                SET title=?, author=?, category=?, isbn=?, copies=?
                WHERE id=?`;

            const values = [
                book.title, book.author, book.category,
                book.isbn, book.copies, id
            ];

            db.query(sql, values, (err, result) => {
                if (err) return sendJSON(res, 500, { error: err.message });

                if (result.affectedRows === 0) {
                    return sendJSON(res, 404, { message: "Book ID not found" });
                }

                sendJSON(res, 200, { message: "Book updated successfully" });
            });
        });
    }

    // DELETE: Remove a book by ID
    else if (req.method === "DELETE" && url.pathname.startsWith("/books/")) {
        const id = url.pathname.split("/")[2];

        db.query("DELETE FROM books WHERE id=?", [id], (err, result) => {
            if (err) return sendJSON(res, 500, { error: err.message });

            if (result.affectedRows === 0) {
                return sendJSON(res, 404, { message: "Book ID not found" });
            }

            sendJSON(res, 200, { message: "Book deleted successfully" });
        });
    }

    // Serve the frontend
    else if (req.method === "GET" && url.pathname === "/") {
        const filePath = path.join(__dirname, "public", "index.html");

        fs.readFile(filePath, (err, content) => {
            if (err) {
                res.writeHead(500, { "Content-Type": "text/plain" });
                return res.end("Unable to load index.html");
            }

            res.writeHead(200, { "Content-Type": "text/html" });
            res.end(content);
        });
    }

    // Unknown route
    else {
        sendJSON(res, 404, { message: "Route not found" });
    }
});

// 5. Start server
server.listen(PORT, () => {
    console.log(`Server running at http://localhost:${PORT}`);
});



